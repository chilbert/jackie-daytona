---
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
}

// Shows a thumbnail and only loads the YouTube player (~1 MB) when someone presses play.
const { id, title } = Astro.props;
---

<div class="video" data-youtube={id} data-title={title}>
  <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
  <button type="button" class="play" aria-label={`Play video: ${title}`}>
    <Icon name="play" size={34} />
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-youtube]').forEach((el) => {
    el.querySelector('button')!.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.youtube}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title ?? 'YouTube video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    });
  });
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: #000;
  }

  .video img,
  .video :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .video img {
    transition:
      transform 0.6s var(--ease),
      opacity 0.3s;
    opacity: 0.8;
  }

  .video:hover img {
    transform: scale(1.04);
    opacity: 1;
  }

  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    padding-left: 4px;
    border: 0;
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--pink) 60%, transparent);
    cursor: pointer;
    transition: transform 0.25s var(--ease);
    animation: pulse 2.4s infinite;
  }

  .play:hover {
    transform: scale(1.08);
  }

  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 22px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
</style>
