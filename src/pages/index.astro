---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import YouTube from '../components/YouTube.astro';
import Gallery from '../components/Gallery.astro';
import Newsletter from '../components/Newsletter.astro';
import { album, links, site, streaming } from '../data/site';

import cover from '../assets/shes-so-hot-cover.png';
import wordmark from '../assets/logo-dark.png';
import logoFull from '../assets/logo-full.png';
import backCover from '../assets/back-cover.jpg';
import insideFace from '../assets/inside-face.jpg';
import linerNotes from '../assets/liner-notes.jpg';
import single from '../assets/comin-to-get-you.png';

const artwork = [
  { src: insideFace, alt: "Pop-art portrait of Jackie Daytona in aviator sunglasses", caption: 'Inside face' },
  { src: linerNotes, alt: 'Liner notes with credits over an octopus wrapped around a space shuttle', caption: 'Liner notes' },
  { src: backCover, alt: "Back cover with the neon palm logo and tracklist", caption: 'Back cover' },
  { src: single, alt: "Comin' To Get You single artwork", caption: "Comin' To Get You" },
];

const marquee = [...album.tracks, ...album.tracks];
---

<Base>
  <!-- Hero -->
  <section class="hero" id="top">
    <div class="sky" aria-hidden="true">
      <div class="sun"></div>
      <div class="grid"></div>
    </div>

    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">New album · Out now</p>
        <h1>
          <Image src={wordmark} alt={site.name} widths={[500, 900]} sizes="(max-width: 900px) 80vw, 520px" loading="eager" class="wordmark" />
          <span class="album-title">{album.title}</span>
        </h1>
        <div class="cta">
          <a class="btn" href="#listen"><Icon name="play" size={16} /> Listen now</a>
          <a class="btn btn--ghost" href="#buy">Buy the album</a>
        </div>
        <ul class="stream" aria-label="Stream on">
          {
            streaming.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} title={s.name}>
                  <Icon name={s.icon} size={20} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero-art">
        <div class="vinyl" aria-hidden="true"></div>
        <Image
          src={cover}
          alt={`${album.title} album cover`}
          widths={[400, 700, 1000]}
          sizes="(max-width: 900px) 80vw, 480px"
          loading="eager"
          fetchpriority="high"
          class="cover"
        />
      </div>
    </div>
  </section>

  <!-- Tracklist marquee -->
  <div class="marquee" aria-hidden="true">
    <div class="track">
      {marquee.map((t) => <span>{t}</span>)}
    </div>
  </div>

  <!-- Listen -->
  <section class="section" id="listen">
    <div class="wrap">
      <p class="eyebrow reveal">Listen</p>
      <h2 class="title reveal">Turn it up</h2>
      <div class="listen">
        <div class="reveal">
          <YouTube id={album.videoId} title={`${site.name} - Comin' To Get You (Official Music Video)`} />
          <ol class="tracks">
            {
              album.tracks.map((t, i) => (
                <li>
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  {t}
                </li>
              ))
            }
          </ol>
        </div>
        <iframe
          class="spotify reveal"
          title={`${album.title} on Spotify`}
          src={`https://open.spotify.com/embed/album/${album.spotifyId}?utm_source=generator&theme=0`}
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
      </div>
    </div>
  </section>

  <!-- Album art -->
  <section class="section album" id="album">
    <div class="wrap">
      <div class="album-head">
        <div>
          <p class="eyebrow reveal">The album</p>
          <h2 class="title reveal">Sounds great<br />in stereo</h2>
        </div>
        <dl class="credits reveal">
          {
            album.credits.map(([role, name]) => (
              <div>
                <dt>{role}</dt>
                <dd>{name}</dd>
              </div>
            ))
          }
          <div>
            <dt>Released</dt>
            <dd>{album.year} · {album.label}</dd>
          </div>
        </dl>
      </div>
      <Gallery items={artwork} />
    </div>
  </section>

  <!-- Buy -->
  <section class="section" id="buy">
    <div class="wrap">
      <p class="eyebrow reveal">Buy</p>
      <h2 class="title reveal">Take it home</h2>
      <div class="cards">
        <a class="card reveal" href={links.bandcamp} target="_blank" rel="noopener" style="--accent: var(--teal)">
          <Icon name="bandcamp" size={32} />
          <h3>Online store</h3>
          <p>Vinyl, CD and digital, direct from Bandcamp.</p>
          <span class="go">Shop Bandcamp <Icon name="arrow" size={18} /></span>
        </a>
        <a class="card reveal" href={links.digital} target="_blank" rel="noopener" style="--accent: var(--pink)">
          <Icon name="download" size={32} />
          <h3>Digital</h3>
          <p>Grab the album from your favorite download store.</p>
          <span class="go">Buy digital <Icon name="arrow" size={18} /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Booking -->
  <section class="section booking" id="booking">
    <div class="wrap booking-inner reveal">
      <Image src={logoFull} alt="" widths={[300, 600]} sizes="280px" class="palm" />
      <div>
        <p class="eyebrow">Live</p>
        <h2 class="title">Book the band</h2>
        <p class="lede">Tour dates are booking now. Clubs, festivals, private parties: get in touch and let's make it hot.</p>
        <a class="btn btn--teal" href={`mailto:${site.bookingEmail}`}><Icon name="mail" size={18} /> {site.bookingEmail}</a>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="section signup" id="newsletter">
    <div class="wrap">
      <Newsletter />
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(100svh, 1000px);
    padding-block: 7rem 5rem;
    overflow: hidden;
    isolation: isolate;
  }

  .sky {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 60% 50% at 75% 35%, color-mix(in srgb, var(--pink) 30%, transparent), transparent 70%),
      radial-gradient(ellipse 50% 40% at 15% 20%, color-mix(in srgb, var(--teal) 18%, transparent), transparent 70%),
      linear-gradient(180deg, var(--ink) 0%, #1a1530 60%, #2a1638 100%);
  }

  .sun {
    position: absolute;
    left: 50%;
    bottom: 26%;
    width: min(70vw, 620px);
    aspect-ratio: 1;
    translate: -50% 50%;
    border-radius: 50%;
    background: linear-gradient(180deg, var(--lemon), var(--sun) 45%, var(--pink) 85%);
    /* horizontal stripes cut through the lower half of the sun */
    mask: linear-gradient(180deg, #000 45%, transparent 45% 49%, #000 49% 58%, transparent 58% 63%, #000 63% 71%, transparent 71% 77%, #000 77% 84%, transparent 84% 91%, #000 91%);
    opacity: 0.28;
    filter: blur(1px);
  }

  .grid {
    position: absolute;
    inset: auto -50% 0;
    height: 42%;
    background:
      linear-gradient(transparent 0 calc(100% - 2px), color-mix(in srgb, var(--pink) 55%, transparent) 0) 0 0 / 100% 60px,
      linear-gradient(90deg, transparent 0 calc(100% - 2px), color-mix(in srgb, var(--teal) 45%, transparent) 0) 0 0 / 80px 100%;
    transform: perspective(300px) rotateX(60deg);
    transform-origin: top;
    mask: linear-gradient(transparent, #000 40%);
    animation: drive 2.5s linear infinite;
  }

  @keyframes drive {
    to {
      background-position:
        0 60px,
        0 0;
    }
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .hero-copy {
    animation: rise 1s var(--ease) both;
  }

  h1 {
    margin: 0 0 2rem;
    font-weight: 400;
  }

  .wordmark {
    width: min(100%, 520px);
    margin-left: -2%;
    filter: drop-shadow(0 0 28px color-mix(in srgb, var(--pink) 45%, transparent));
  }

  .album-title {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--display);
    font-size: clamp(3.2rem, 9vw, 7rem);
    line-height: 0.9;
    text-transform: uppercase;
    background: linear-gradient(90deg, var(--lemon), var(--sun), var(--pink));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .stream {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .stream::before {
    content: 'Stream on';
    margin-right: 0.5rem;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .stream a {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--cream) 8%, transparent);
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.2s var(--ease);
  }

  .stream a:hover {
    background: var(--cream);
    color: var(--ink);
    transform: translateY(-3px);
  }

  .hero-art {
    position: relative;
    width: min(100%, 480px);
    justify-self: center;
    animation: rise 1s 0.15s var(--ease) both;
  }

  .cover {
    position: relative;
    width: 100%;
    border-radius: 6px;
    transform: rotate(-3deg);
    box-shadow:
      0 30px 80px -20px color-mix(in srgb, var(--pink) 60%, transparent),
      0 0 0 1px color-mix(in srgb, var(--cream) 10%, transparent);
    transition: transform 0.6s var(--ease);
  }

  .hero-art:hover .cover {
    transform: rotate(0deg) translateX(-6%);
  }

  .vinyl {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--pink) 0 14%, #111 14.5% 16%, transparent 16.5%),
      repeating-radial-gradient(circle, #111 0 2px, #1c1c1c 2px 4px);
    transform: translateX(22%);
    transition: transform 0.6s var(--ease);
    animation: spin 6s linear infinite;
  }

  .hero-art:hover .vinyl {
    transform: translateX(34%);
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-copy {
      order: 2;
    }

    .wordmark {
      margin-inline: auto;
    }

    .cta,
    .stream {
      justify-content: center;
    }

    .stream {
      flex-wrap: wrap;
    }

    .stream::before {
      flex-basis: 100%;
      margin: 0 0 0.25rem;
    }

    .hero-art {
      width: min(78%, 380px);
      margin-right: 12%;
    }
  }

  /* Marquee */
  .marquee {
    overflow: hidden;
    padding-block: 1.1rem;
    background: var(--pink);
    color: var(--ink);
    transform: rotate(-1.5deg) scale(1.02);
  }

  .track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }

  .track span {
    padding-inline: 1.5rem;
    font-family: var(--display);
    font-size: clamp(1.4rem, 3vw, 2rem);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .track span::after {
    content: '✦';
    margin-left: 3rem;
    font-size: 0.8em;
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

  /* Listen */
  .listen {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  .spotify {
    width: 100%;
    height: 560px;
    border: 0;
    border-radius: var(--radius);
  }

  .tracks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.25rem 2rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .tracks li {
    display: flex;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--cream) 8%, transparent);
    font-weight: 600;
  }

  .num {
    color: var(--pink);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    .listen {
      grid-template-columns: 1fr;
    }

    .spotify {
      height: 450px;
    }
  }

  @media (max-width: 480px) {
    .tracks {
      grid-template-columns: 1fr;
    }
  }

  /* Album */
  .album {
    background: var(--ink-2);
  }

  .album-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .album-head .title {
    margin: 0;
  }

  .credits {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 1rem 2.5rem;
    margin: 0;
  }

  .credits dt {
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .credits dd {
    margin: 0;
    font-weight: 600;
  }

  /* Buy */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--cream) 10%, transparent);
    border-radius: var(--radius);
    background: var(--ink-2);
    color: var(--accent);
    text-decoration: none;
    transition:
      transform 0.35s var(--ease),
      border-color 0.35s;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: auto -30% -60% auto;
    width: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
    filter: blur(60px);
    transition: opacity 0.35s;
  }

  .card:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
  }

  .card:hover::before {
    opacity: 0.25;
  }

  .card h3 {
    margin: 0.5rem 0 0;
    color: var(--cream);
    font-family: var(--display);
    font-size: 2rem;
    font-weight: 400;
    text-transform: uppercase;
  }

  .card p {
    flex: 1;
    margin: 0;
    color: var(--muted);
  }

  .go {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .go :global(svg) {
    transition: transform 0.25s var(--ease);
  }

  .card:hover .go :global(svg) {
    transform: translateX(5px);
  }

  /* Booking */
  .booking {
    background:
      radial-gradient(ellipse 50% 70% at 20% 50%, color-mix(in srgb, var(--teal) 16%, transparent), transparent 70%),
      var(--slate);
  }

  .booking-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .palm {
    width: clamp(180px, 25vw, 280px);
    transform: rotate(-6deg);
  }

  .booking .btn {
    text-transform: none;
    letter-spacing: 0;
  }

  @media (max-width: 700px) {
    .booking-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .booking .lede {
      margin-inline: auto;
    }

    .booking .btn {
      max-width: 100%;
      overflow-wrap: anywhere;
    }
  }

  /* Newsletter */
  .signup {
    background:
      radial-gradient(ellipse 60% 80% at 50% 120%, color-mix(in srgb, var(--pink) 30%, transparent), transparent 70%),
      var(--ink);
  }
</style>
